# Copy to .env and replace placeholders. Do not commit .env.

# Application
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
APP_ENV=development
ALLOWED_HOSTS=127.0.0.1,localhost
PUBLIC_BASE_URL=http://127.0.0.1:8000
PUBLIC_CONSOLE_URL=http://localhost:4200
# Required for live Cashfree DigiLocker when console URL is http (local dev).
# CASHFREE_DIGILOCKER_REDIRECT_URL=https://your-console-domain/app/onboarding
TIME_ZONE=Asia/Kolkata
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:4200,http://localhost:4200
ADMIN_URL=admin/
# Optional in every environment: comma-separated IPs or CIDRs that may open
# Django admin. Leave empty for no IP restriction (recommended: set in production).
ADMIN_ALLOWED_IPS=
ADMIN_TRUST_X_FORWARDED_FOR=False
# Authenticator (TOTP) for platform admins. Defaults to True when APP_ENV is
# staging or production (mandatory there for admins), optional for everyone else
# and in development.
ADMIN_REQUIRE_OTP=False

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=payswaphub
DB_USER=payswaphub
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Leave unset in development (defaults to 0). Use 60+ in staging/production.
# DB_CONN_MAX_AGE=0

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# Local default is True (send email/SMS in the web process). Set False in
# staging/production and run a Celery worker.
CELERY_TASK_ALWAYS_EAGER=True

# Email — AWS SES SMTP (see Payswap Angular public/api/ses-smtp.php)
EMAIL_BACKEND=integrations.smtp.SesSmtpEmailBackend
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-ses-smtp-username
EMAIL_HOST_PASSWORD=replace-with-ses-smtp-password
DEFAULT_FROM_EMAIL=Payswap <noreply@payswap.in>
OTP_FROM_EMAIL=Payswap <support@payswap.in>
OTP_REPLY_TO_EMAIL=support@payswap.in
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# To send via SES API instead of SMTP:
# EMAIL_BACKEND=integrations.ses.SesEmailBackend

# Kaleyra SMS (Indian transactional). Sender must match DLT header (PYSWAP).
# Console API key name: payswap_backend_v2
KALEYRA_API_KEY_NAME=payswap_backend_v2
KALEYRA_ACCOUNT_SID=replace-with-kaleyra-account-sid
KALEYRA_API_KEY=replace-with-kaleyra-api-key
KALEYRA_SENDER=PYSWAP
KALEYRA_SENDER_ID=PYSWAP
KALEYRA_BASE_URL=https://api.in.kaleyra.io
KALEYRA_ENTITY_ID=
# DLT template map — verification_code: Payswap OTP (1007141008198087301)
KALEYRA_DLT_TEMPLATES={"verification_code":"1007141008198087301"}
KALEYRA_WEBHOOK_SECRET=replace-with-random-urlsafe-secret
# Object storage (optional). When set, KYC media is stored on S3 instead of local disk.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Cashfree Secure ID (PAN, GSTIN, bank, IFSC, DigiLocker Aadhaar, eSign)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
# RSA public key from Cashfree dashboard (2FA / dynamic IP). Used to build x-cf-signature.
CASHFREE_PUBLIC_KEY_PATH=Cashfree key/accountId_59940_public_key.pem
# HMAC secret for inbound Cashfree webhooks (x-webhook-signature). Leave empty
# to keep the receiver closed.
CASHFREE_WEBHOOK_SECRET=

# Verification reuse window in days (a successful verification is reused while
# now < completed_at + N days).
VERIFICATION_CACHE_DAYS=30
FEATURE_DIGILOCKER=True
FEATURE_ESIGN=True

# Test-mode OTP. AUTH_TEST_MODE must be False in staging/production (startup
# fails otherwise); TEST_OTP is only ever accepted when AUTH_TEST_MODE=True.
AUTH_TEST_MODE=True
TEST_OTP=123456
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Encryption (Fernet key — required for sensitive fields)
FIELD_ENCRYPTION_KEY=replace-with-fernet-urlsafe-key

# Sentry (leave empty to disable)
SENTRY_DSN=

# Legal disclosures — required before staging or production starts
LEGAL_ENTITY_NAME=PAYSWAP FINTECH PRIVATE LIMITED
GRIEVANCE_OFFICER_NAME=ABHISHEK BANSAL
GRIEVANCE_EMAIL=Abhishek@payswap.in
GRIEVANCE_POSTAL_ADDRESS=4TH, C-24 A, PANKAJ SINGHVI MARG, LAL KOTHI, Jaipur, Rajasthan, 302015, India

# Company tax identifiers printed on purchase-order documents (set real values in staging/production)
COMPANY_GSTIN=
COMPANY_PAN=
COMPANY_VOUCHER_HSN=4907
